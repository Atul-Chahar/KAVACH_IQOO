    <string name="state_watching_body">Nothing unusual so far.</string>
    <string name="state_caution_title">Be careful</string>
    <string name="state_caution_body">This conversation matches some patterns used in scams.</string>
    <string name="state_high_risk_title">This looks like a scam</string>
    <string name="state_high_risk_body">This conversation strongly matches a known scam script.</string>

