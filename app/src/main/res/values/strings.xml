<resources>
    <string name="app_name" translatable="false">Kavach</string>

    <!--
      docs/SAFETY.md 2 requires this exact sentiment in onboarding, in the
      foreground notification, and out loud in the pitch. Do not delete it.
    -->
    <string name="safety_no_guarantee">No alert is not a guarantee of safety.</string>
    <!--
      docs/SAFETY.md 3: we say "matches known scam patterns", never "this is a
      scam". Kavach is not making a legal or financial determination.
    -->
    <string name="safety_pattern_disclaimer">Kavach matches conversations against known scam patterns. It cannot tell you for certain what is happening.</string>

    <string name="state_idle_title">Not listening</string>
    <string name="state_idle_body">Kavach is off. Start it when you are on a call you are unsure about.</string>
