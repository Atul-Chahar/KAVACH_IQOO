{
  "$schema": "kavach.tactic-lexicon.v1",
  "version": "1.0.0",
  "updated": "2026-08-27",
  "provenance": "Markers compiled from publicly published advisories: I4C citizen advisory on digital arrest, PhonePe Trust & Safety, Seqrite threat research, RBI advisories on remote-access-app fraud, and mainstream red-flag explainers. No private or field data.",
  "notes": "Romanised (Hinglish) spellings are included deliberately so keyword matching survives imperfect ASR on code-switched speech. Match case-insensitively on a normalised transcript.",

  "scoring": {
    "highRiskThreshold": 70,
    "cautionThreshold": 40,
    "decayHalfLifeSeconds": 120,
    "minDistinctFamiliesForHighRisk": 3,
    "familyDiversityBonus": 12,
    "maxScorePerFamily": 30
  },

